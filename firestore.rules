rules_version = '2';

// Firestore holds the answer key, the question bank, and match history.
// None of it is ever readable or writable by a client. Only the Cloud
// Functions (Admin SDK) touch this data. This is half of "the client
// renders, the server decides": the answer key lives where the phone
// cannot reach it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
