# Copy this file to app/.env and fill in what you need.
# For the default emulator demo you only need to set EXPO_PUBLIC_EMULATOR_HOST
# to your computer's LAN IP so your phone can reach the emulators.

# Your computer's LAN IP, for example 192.168.1.20. Find it with `ipconfig`
# (Windows) or `ipconfig getifaddr en0` (macOS). The phone and computer must be
# on the same wifi.
EXPO_PUBLIC_EMULATOR_HOST=localhost

# Leave true to run fully local against the Firebase Emulator Suite (zero cost,
# zero cloud setup). Set to false only when pointing at a real Blaze project.
EXPO_PUBLIC_USE_EMULATOR=true

# --- Only needed when EXPO_PUBLIC_USE_EMULATOR=false (real project) ----------
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_DATABASE_URL=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
